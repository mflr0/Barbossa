# Token du bot (Discord Developer Portal → ton application → Bot → Reset Token)
DISCORD_TOKEN=

# Seul serveur où le bot accepte de travailler (clic droit sur le serveur → Copier l'identifiant).
# Ajouté sur un autre serveur, il en repart aussitôt : personne ne peut dépenser ton budget d'IA en l'invitant ailleurs.
SERVER_ID=

# Ton identifiant Discord (clic droit sur ton profil → Copier l'identifiant) : seul ce compte peut changer le budget avec /status.
OWNER_ID=

# Salon où le bot écrit ses logs (clic droit sur le salon → Copier l'identifiant)
MOD_LOG_CHANNEL_ID=

# Clés des fournisseurs d'IA : seules celles des fournisseurs utilisés ci-dessous sont nécessaires.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini : clé gratuite sur aistudio.google.com (attention : Google utilise le contenu de son offre gratuite
# pour améliorer ses produits).
GEMINI_API_KEY=

# Fournisseurs d'IA, essayés dans l'ordre (les gratuits toujours en premier) : anthropic, openai, gemini.
# « fournisseur:modèle » pour choisir le modèle. Modèles par défaut : claude-haiku-5-5, gpt-6-luna, gemini-3.5-flash-lite.
AI_PROVIDERS=anthropic
# Ceux utilisés en offre gratuite : leurs réponses ne comptent pas dans le budget. Ex. avec Gemini :
# AI_PROVIDERS=gemini,anthropic
# AI_FREE=gemini
AI_FREE=

# Facultatif : budget d'IA payante par jour au démarrage (défaut 0.3 $, réglable ensuite avec /status)
# CHAT_DAILY_BUDGET=0.3
